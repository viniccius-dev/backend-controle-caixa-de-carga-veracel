# ------------------------------------------------------------------ servidor
NODE_ENV=development
PORTA=3001

# Chave que a planilha e o leitor enviam no cabecalho X-API-Key.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
API_KEY=troque-esta-chave

# Caminho do arquivo SQLite. Fora de src/ para nao ir junto no deploy.
BANCO=./database/alerta-cx-carga.db

# Maximo de viagens por lote.
MAX_LOTE=500

# ------------------------------------------------------------ leitor de e-mail
# Conta que RECEBE os lotes (nao e a que envia, da Veracel).
IMAP_HOST=imap.gmail.com
IMAP_PORTA=993
IMAP_USUARIO=torredecontrole.veracel@gmail.com
# No Gmail: ative a verificacao em duas etapas e gere uma SENHA DE APLICATIVO em
# myaccount.google.com > Seguranca > Senhas de app. Cole aqui, sem espacos.
IMAP_SENHA=

IMAP_CAIXA=INBOX
IMAP_PASTA_OK=Processados
IMAP_PASTA_ERRO=Erros

# So aceita mensagem destes remetentes (separe por virgula) e com este codigo no
# assunto. O codigo precisa ser identico ao CODIGO_ENVIO da macro VBA.
REMETENTES_AUTORIZADOS=marcos.moby@veracel.com.br
CODIGO_ENVIO=IMPORTACAO-VIAGENS

# Agendamento do leitor dentro do servidor. LEITOR_ATIVO=false desliga (util quando
# quiser rodar so pelo npm run leitor:once).
LEITOR_ATIVO=true
LEITOR_CRON=*/2 * * * *

# true = processa so as nao lidas. Deixe false: mensagem que a propria conta envia
# para si mesma chega ja marcada como lida e seria ignorada.
LEITOR_SOMENTE_NAO_LIDAS=false

# Origens da plataforma web que podem chamar esta API (separe por virgula).
# Vazio libera qualquer origem - use so em desenvolvimento.
ORIGENS_PERMITIDAS=
